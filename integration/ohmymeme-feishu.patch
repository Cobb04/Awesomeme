+/* 飞书导入：沿用设置页 API 桥接和后台任务轮询。 */
+let feishuPollTimer = null;
+let feishuPollGeneration = 0;
+let feishuBusy = false;
+let feishuGeneration = 0;
+
+function stopFeishuPoll() {
+  feishuPollGeneration++;
+  if (feishuPollTimer !== null) clearTimeout(feishuPollTimer);
+  feishuPollTimer = null;
+}
+
+function renderFeishuState(s) {
+  if (Number.isInteger(s.generation)) feishuGeneration = s.generation;
+  feishuBusy = !!s.busy;
+  document.getElementById('feishu-import-message').textContent = s.message || '尚未开始';
+  const qr = document.getElementById('feishu-import-qr');
+  if (s.qr_src && s.status === 'waiting_scan' && s.qr_src.startsWith('data:image/svg+xml;base64,')) {
+    qr.src = s.qr_src;
+    qr.style.display = '';
+  } else {
+    qr.removeAttribute('src');
+    qr.style.display = 'none';
+  }
+  const progress = document.getElementById('feishu-import-progress');
+  progress.style.display = s.total ? '' : 'none';
+  progress.value = s.total ? Math.min(100, 100 * (s.done || 0) / s.total) : 0;
+  document.getElementById('feishu-import-start').disabled = feishuBusy;
+  document.getElementById('feishu-import-start').textContent = s.status === 'idle' ? '开始扫码导入' : '重新扫码导入';
+  document.getElementById('feishu-import-close').textContent = feishuBusy ? '取消导入' : '关闭';
+  const r = s.result;
+  const reasons = {qr_expired:'二维码已过期，请重新扫码。', qr_timeout:'扫码超时，请重新扫码。', snapshot_changed:'导出期间收藏发生变化，请重新导入。', http_status_401:'登录授权失效，请重新扫码。', http_status_403:'访问被拒绝，请稍后重试。', http_status_429:'请求过于频繁，请稍后重试。'};
+  document.getElementById('feishu-import-result').textContent = r
+    ? `新增 ${r.ids.length} · 重复 ${r.skipped_dup} · 拒绝 ${r.rejected} · 未确认 ${r.unaccounted}`
+    : s.reason ? (reasons[s.reason] || '请查看导出报告中的失败记录。') : '';
+  if (s.export_dir) document.getElementById('feishu-import-result').textContent += `\n导出目录：${s.export_dir}`;
+}
+
+async function pollFeishuImport(generation) {
+  if (generation !== feishuPollGeneration) return;
+  try {
+    const state = await api('get_feishu_import_progress');
+    if (generation !== feishuPollGeneration) return;
+    if (!state) throw new Error('bridge unavailable');
+    renderFeishuState(state);
+    if (state.busy) feishuPollTimer = setTimeout(() => pollFeishuImport(generation), 700);
+    else if (state.result?.ids?.length) {
+      await Promise.allSettled([api('refresh_memes'), api('refresh_collections')]);
+    }
+  } catch (_) {
+    if (generation !== feishuPollGeneration) return;
+    renderFeishuState({status:'error', busy:true, message:'连接中断。请取消任务后重新打开。'});
+  }
+}
+
+async function openFeishuImportDialog() {
+  stopFeishuPoll();
+  document.getElementById('feishu-import-overlay').style.display = 'flex';
+  renderFeishuState({status:'loading', busy:true, message:'正在读取任务状态'});
+  await pollFeishuImport(feishuPollGeneration);
+}
+
+async function startFeishuImport() {
+  if (feishuBusy) return;
+  stopFeishuPoll();
+  const generation = feishuPollGeneration;
+  renderFeishuState({status:'running', busy:true, message:'正在启动'});
+  try {
+    const result = await api('start_feishu_import', feishuGeneration);
+    if (generation !== feishuPollGeneration) return;
+    if (!result || !result.ok) {
+      renderFeishuState({status:'error', busy:false, message:result?.error || '启动失败'});
+      return;
+    }
+    await pollFeishuImport(generation);
+  } catch (_) {
+    if (generation === feishuPollGeneration) {
+      renderFeishuState({status:'error', busy:false, message:'启动失败，请重新打开'});
+    }
+  }
+}
+
+async function closeFeishuImportDialog() {
+  if (feishuBusy) {
+    stopFeishuPoll();
+    const generation = feishuPollGeneration;
+    renderFeishuState({status:'cancelling', busy:true, message:'正在取消，请等待当前读取结束'});
+    try {
+      const result = await api('cancel_feishu_import', feishuGeneration);
+      if (generation !== feishuPollGeneration) return;
+      if (!result?.ok) throw new Error('cancel failed');
+      await pollFeishuImport(generation);
+    } catch (_) {
+      if (generation === feishuPollGeneration) {
+        renderFeishuState({status:'error', busy:true, message:'取消未确认。请关闭设置窗口停止任务。'});
+      }
+    }
+    return;
+  }
+  stopFeishuPoll();
+  renderFeishuState({status:'idle', busy:false});
+  document.getElementById('feishu-import-overlay').style.display = 'none';
+}
+
+window.addEventListener('beforeunload', () => {
+  stopFeishuPoll();
+  if (feishuBusy) api('cancel_feishu_import', feishuGeneration);
+  document.getElementById('feishu-import-qr')?.removeAttribute('src');
+});
