+    def get_feishu_import_progress(self):
+        """读取飞书任务状态，二维码只经内存桥接传递。"""
+        with self._webui._feishu_job_lock:
+            job = self._webui._feishu_job
+            state = job.state() if job else {"status": "idle", "busy": False}
+            state["generation"] = (
+                self._webui._feishu_run_generation
+                if state["busy"]
+                else self._webui._feishu_next_generation
+            )
+            return state
+
+    def cancel_feishu_import(self, generation=None):
+        """请求取消飞书导入。"""
+        with self._webui._feishu_job_lock:
+            if generation is None or generation == self._webui._feishu_next_generation:
+                self._webui._feishu_next_generation += 1
+            job = self._webui._feishu_job
+            if job and (
+                generation is None or generation == self._webui._feishu_run_generation
+            ):
+                return job.cancel()
+            return {"ok": True}
